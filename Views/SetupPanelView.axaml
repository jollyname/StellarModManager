<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarModManager.ViewModels"
             xmlns:loc="using:StellarModManager.Services"
             x:Class="StellarModManager.Views.SetupPanelView"
             x:DataType="vm:MainWindowViewModel">

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <!-- Single centred card -->
        <Border
            Width="410"
            CornerRadius="20"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource Theme.SetupPanelBrush}">

            <Grid RowDefinitions="320,Auto">

                <!-- HERO -->
                <Grid Grid.Row="0" ClipToBounds="True">

                    <Image Source="/Assets/Hero.png"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>

                    <!-- Brand mark, top-left -->
                    <Border
                        Width="36"
                        Height="36"
                        Margin="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Image Source="/Assets/Logo.png" Stretch="Uniform"/>
                    </Border>

                </Grid>

                <!-- BODY -->
                <StackPanel Grid.Row="1" Margin="28,24,28,28" Spacing="16" HorizontalAlignment="Stretch">

                    <TextBlock
                        Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[WelcomeTitle]}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource Theme.TextOnAccentBrush}"/>

                    <TextBlock
                        IsVisible="{Binding MelonLoaderStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding MelonLoaderStatusText}"
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource Theme.TextMutedBrush}"/>

                    <!-- Auto-detected installs -->
                    <StackPanel Spacing="8"
                                IsVisible="{Binding !!DetectedGameInstalls.Count}">
                        <TextBlock
                            Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DetectedGameInstalls]}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            Foreground="{DynamicResource Theme.TextMutedBrush}"/>

                        <ItemsControl ItemsSource="{Binding DetectedGameInstalls}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="gameCard" Padding="10">
                                        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    Width="36" Height="36"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Directory.Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Source}"
                                                           FontSize="11"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Classes="secondary"
                                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SelectFolder]}"
                                                    Command="{Binding $parent[UserControl].DataContext.SelectSuggestedFolderCommand}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button
                        Classes="primary"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ChooseGameFolder]}"
                        Command="{Binding SelectGameFolderCommand}"
                        Height="44"
                        CornerRadius="22"
                        Padding="0"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>

                    <Button
                        Classes="secondary"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[InstallMelonLoaderAuto]}"
                        IsVisible="{Binding !IsMelonLoaderValid}"
                        IsEnabled="{Binding !IsInstallingMelonLoader}"
                        Command="{Binding InstallMelonLoaderCommand}"
                        Height="44"
                        CornerRadius="22"
                        Padding="0"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>

                    <StackPanel
                        IsVisible="{Binding IsInstallingMelonLoader}"
                        Spacing="6">
                        <ProgressBar Classes="modProgress" Minimum="0" Maximum="100" IsIndeterminate="True"/>
                        <TextBlock
                            Text="{Binding InstallProgressText}"
                            FontSize="12"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                    </StackPanel>

                    <Button
                        Classes="primary"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Continue]}"
                        IsVisible="{Binding IsMelonLoaderValid}"
                        Command="{Binding CloseSetupCommand}"
                        Height="44"
                        CornerRadius="22"
                        Padding="0"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>

                    <!-- Locale is pickable before setup finishes, same binding the settings panel uses -->
                    <StackPanel Spacing="6" Margin="0,6,0,0">
                        <TextBlock
                            Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[LanguageLabel]}"
                            FontSize="12"
                            TextAlignment="Center"
                            Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                        <ComboBox
                            Name="SetupLanguageBox"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding Converter={x:Static vm:MainWindowViewModel.LanguageNameConverter}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

    </Border>

</UserControl>

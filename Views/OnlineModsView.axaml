<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StellarModManager.Controls"
             xmlns:vm="using:StellarModManager.ViewModels"
             xmlns:models="using:StellarModManager.Models"
             xmlns:loc="using:StellarModManager.Services"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="StellarModManager.Views.OnlineModsView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" MinWidth="95"  MaxWidth="500" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                     PlaceholderText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SearchPlaceholder]}"
                     Text="{Binding SearchText}">
                <TextBox.InnerRightContent>
                    <svg:Svg Grid.Column="0"
                             Path="/Assets/Icons/search.svg"
                             Width="16"
                             Height="16"
                             Stretch="Uniform"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="0,0,12,0"/>
                </TextBox.InnerRightContent>
            </TextBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="16,0,8,0">
                <TextBlock Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortLabel]}"/>
                <ComboBox MinWidth="190" SelectedIndex="{Binding SortIndex}">
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortMostDownloaded]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortRecentlyUpdated]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortName]}"/>
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="3" Classes="ghost" Command="{Binding RefreshModsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <svg:Svg Grid.Column="0"
                             Path="/Assets/Icons/refresh.svg"
                             Width="16"
                             Height="16"
                             Stretch="Uniform"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Refresh]}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Column headers -->
        <Grid Grid.Row="1" IsVisible="{Binding !IsCompactView}" ColumnDefinitions="60,*,70,80,110,120" Height="32" Margin="12,0">
            <TextBlock Grid.Column="1" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnName]}"/>
            <TextBlock Grid.Column="2" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnVersion]}"/>
            <TextBlock Grid.Column="3" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnDownloads]}"/>
            <TextBlock Grid.Column="4" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnUpdated]}"/>
            <TextBlock Grid.Column="5" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnState]}"/>
        </Grid>
        <Rectangle Grid.Row="1" Classes="separator" VerticalAlignment="Bottom" IsVisible="{Binding !IsCompactView}"/>

        <TextBlock Grid.Row="2" Classes="secondary" FontSize="14" Margin="12,16"
                   IsVisible="{Binding !VisibleOnlineMods.Count}"
                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NoModsFound]}"/>

        <ListBox Grid.Row="2" Classes="table" IsVisible="{Binding !IsCompactView}"
                 Margin="0,4,0,0"
                 ItemsSource="{Binding VisibleOnlineMods}"
                 SelectedItem="{Binding BrowseSelection}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:OnlineModInfo">
                    <Grid>
                        <Border Classes="pill"/>
                        <Grid ColumnDefinitions="60,*,70,80,110,120" Margin="12,0">
                            <Border Classes="thumbnail" Width="48" Height="48" HorizontalAlignment="Left">
                                <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="secondary" Text="{Binding Author}" MaxWidth="160"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <!-- Should probably not show every tag... -->
                                    <ItemsControl ItemsSource="{Binding _Tags}" VerticalAlignment="Center"
                                                  IsVisible="{Binding _Tags.Count}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModTag">
                                                <Border Classes="tag"
                                                        Classes.assisted="{Binding IsAssisted}"
                                                        Classes.vibecoded="{Binding IsVibecoded}"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.inactive="{Binding IsInactive}">
                                                    <TextBlock Text="{Binding Text}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Version}"/>
                            <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Downloads, StringFormat={}{0:N0}}"/>
                            <TextBlock Grid.Column="4" Classes="cell" Text="{Binding UpdatedText}"/>

                            <Panel Grid.Column="5" VerticalAlignment="Center">
                                <TextBlock Classes="cell success" IsVisible="{Binding ShowInstalledState}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateInstalled]}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowUpdateState}">
                                    <TextBlock Classes="cell accent" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateUpdate]}"/>
                                    <TextBlock Classes="cell accent" Text="{Binding Version}"/>
                                </StackPanel>
                                <TextBlock Classes="cell" Text="—" IsVisible="{Binding ShowNoState}"/>
                                <StackPanel Spacing="6" IsVisible="{Binding IsInstalling}" Margin="0,0,16,0">
                                    <TextBlock Classes="cell" Text="{Binding DownloadProgress, StringFormat={}{0:0} %}"/>
                                    <ProgressBar Classes="modProgress" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"/>
                                </StackPanel>
                            </Panel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Compact view: card grid -->
        <ListBox Grid.Row="2" Classes="cards" Margin="0,4,0,0"
                 IsVisible="{Binding IsCompactView}"
                 ItemsSource="{Binding VisibleOnlineMods}"
                 SelectedItem="{Binding BrowseSelection}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:GridWrapPanel ItemWidth="225" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:OnlineModInfo">
                    <Grid RowDefinitions="Auto,Auto">

                        <c:AspectRatio WidthParameter="16" HeightParameter="9">
                            <Border Classes="cardThumbnail">
                                <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                            </Border>
                        </c:AspectRatio>

                        <StackPanel Grid.Row="1" Margin="12,10,12,12" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Classes="secondary" Text="{Binding Author}" TextTrimming="CharacterEllipsis"/>

                            <!-- AI tag -->
                            <ItemsControl ItemsSource="{Binding _Tags}" Margin="0,6,0,0"
                                          IsVisible="{Binding _Tags.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModTag">
                                        <Border Classes="tag"
                                                Classes.assisted="{Binding IsAssisted}"
                                                Classes.vibecoded="{Binding IsVibecoded}"
                                                Classes.active="{Binding IsActive}"
                                                Classes.inactive="{Binding IsInactive}"
                                                Margin="0,0,4,4">
                                            <TextBlock Text="{Binding Text}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Version}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding DownloadsText}"/>
                                </TextBlock>
                                <Panel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Classes="secondary success" IsVisible="{Binding ShowInstalledState}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateInstalled]}"/>
                                    <TextBlock Classes="secondary accent" IsVisible="{Binding ShowUpdateState}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateUpdate]}"/>
                                    <TextBlock Classes="secondary" IsVisible="{Binding IsInstalling}"
                                               Text="{Binding DownloadProgress, StringFormat={}{0:0} %}"/>
                                </Panel>
                            </Grid>
                            <ProgressBar Classes="modProgress" Margin="0,6,0,0" IsVisible="{Binding IsInstalling}"
                                         Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StellarModManager.ViewModels"
        xmlns:views="using:StellarModManager.Views"
        xmlns:loc="using:StellarModManager.Services"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="StellarModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        Title="Stellar Mod Manager"
        Width="1280" Height="820"
        MinWidth="1010" MinHeight="600"
        Background="{DynamicResource Theme.BackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="48,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="Transparent"
              WindowDecorationProperties.ElementRole="TitleBar">
            <Image Grid.Column="0" Source="/Assets/icon.ico" Width="16" Height="16" Margin="12,0,8,0"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="secondary" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding $parent[Window].Title}"/>

                <!-- Play/Stop button -->
                <Button Classes="ghost" Height="30" Margin="24,0,0,0" Padding="10,0,12,0"
                        VerticalAlignment="Center" CornerRadius="6"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                        Command="{Binding ToggleGameCommand}"
                        IsVisible="{Binding !SetupRequired}"
                        WindowDecorationProperties.ElementRole="User">

                    <Panel>
                        <!-- Play -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsGameRunning}"
                                    ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PlayGame]}">
                            <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/play.svg" Width="14" Height="14" Stretch="Uniform"
                                     VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PlayButton]}"/>
                        </StackPanel>

                        <!-- Stop -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsGameRunning}"
                                    ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StopGame]}">
                            <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/square.svg" Width="14" Height="14" Stretch="Uniform"
                                     VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StopButton]}"/>
                        </StackPanel>
                    </Panel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="caption" Click="OnMinimizeClick"
                        WindowDecorationProperties.ElementRole="MinimizeButton">
                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/minimize.svg" Width="16" Height="16" Stretch="Uniform"/>
                </Button>

                <Button Classes="caption" Click="OnMaximizeClick"
                        WindowDecorationProperties.ElementRole="MaximizeButton">
                    <Panel>
                        <svg:Svg Css="{DynamicResource Theme.IconCss}" Classes="glyphMaximize" Path="/Assets/Icons/square.svg"
                                 Width="16" Height="16" Stretch="Uniform"/>
                        <svg:Svg Css="{DynamicResource Theme.IconCss}" Classes="glyphRestore" Path="/Assets/Icons/restore.svg"
                                 Width="16" Height="16" Stretch="Uniform"/>
                    </Panel>
                </Button>

                <Button Classes="caption close" Click="OnCloseClick"
                        WindowDecorationProperties.ElementRole="CloseButton">
                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/close.svg" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <!-- SETUP -->
            <views:SetupPanelView IsVisible="{Binding SetupRequired}"/>

            <!-- MAIN APP -->
            <SplitView
                       IsVisible="{Binding !SetupRequired}"
                       IsPaneOpen="{Binding IsPaneOpen}"
                       OpenPaneLength="180"
                       DisplayMode="CompactInline"
                       CompactPaneLength="50"
                       PaneBackground="Transparent">

                <SplitView.Pane>
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="4,8,4,8">

                        <Button Grid.Row="1" Classes="ghost icon" Width="42" Height="36"
                                Command="{Binding TogglePaneCommand}"
                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ToggleNavigation]}">
                            <svg:Svg Grid.Column="0"
                                Path="/Assets/Icons/menu.svg"
                                Css="{DynamicResource Theme.IconCss}"
                                Width="20"
                                Height="20"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                        </Button>
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <Button Classes="nav" Classes.selected="{Binding IsBrowsePage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Browse}">
                                <Grid ColumnDefinitions="44,*,Auto">
                                    <Border Classes="pill"/>
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                             Path="/Assets/Icons/browse.svg"
                                             Width="24"
                                             Height="24"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavBrowse]}"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsLibraryPage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Library}">
                                <Grid ColumnDefinitions="44,*,Auto">
                                    <Border Classes="pill"/>
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                             Path="/Assets/Icons/library.svg"
                                             Width="24"
                                             Height="24"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavLibrary]}"/>
                                    <TextBlock Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Theme.TextMutedBrush}"
                                               Text="{Binding InstalledMods.Count}"
                                               IsVisible="{Binding !!InstalledMods.Count}"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsUpdatesPage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Updates}">
                                <Grid ColumnDefinitions="44,*,Auto">
                                    <Border Classes="pill"/>
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                             Path="/Assets/Icons/update.svg"
                                             Width="24"
                                             Height="24"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavUpdates]}"/>
                                    <Border Grid.Column="2" Classes="badge" Margin="0,0,12,0"
                                            IsVisible="{Binding !!AvailableModUpdates.Count}">
                                        <TextBlock Text="{Binding AvailableModUpdates.Count}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Game folder -->
                        <Button Grid.Row="3" Classes="ghost" Margin="4,0,4,8" Padding="12,10"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="{DynamicResource Theme.SurfaceBrush}"
                                IsVisible="{Binding IsPaneOpen}"
                                Command="{Binding SelectGameFolderCommand}"
                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ChangeGameFolder]}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="secondary"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[GameLabel]}"/>
                                <TextBlock Text="{Binding GamePath}" FontSize="13" TextTrimming="PrefixCharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMelonLoaderValid}">
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/check.svg"
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>   
                                    <TextBlock Classes="success" FontSize="12"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MelonLoaderInstalled]}"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Theme.DangerBrush}"
                                           IsVisible="{Binding !IsMelonLoaderValid}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MelonLoaderMissing]}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="4" Classes="nav" Classes.selected="{Binding IsSettingsPage}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}">
                            <Grid ColumnDefinitions="44,*">
                                <Border Classes="pill"/>
                                <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                    Path="/Assets/Icons/settings.svg"
                                    Width="24"
                                    Height="24"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SettingsTitle]}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </SplitView.Pane>

                <Border Background="{DynamicResource Theme.ContentBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8,0,0,0"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto">

                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" Margin="32,24,24,0">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                <Panel>
                                    <TextBlock Classes="pageTitle" IsVisible="{Binding IsBrowsePage}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavBrowse]}"/>
                                    <TextBlock Classes="pageTitle" IsVisible="{Binding IsLibraryPage}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavLibrary]}"/>
                                    <TextBlock Classes="pageTitle" IsVisible="{Binding IsUpdatesPage}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavUpdates]}"/>
                                    <TextBlock Classes="pageTitle" IsVisible="{Binding IsSettingsPage}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SettingsTitle]}"/>
                                </Panel>

                                <!-- List / compact view switch -->
                                <Border Grid.Column="1" Classes="segmented" IsVisible="{Binding !IsSettingsPage}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="ghost" Classes.selected="{Binding !IsCompactView}"
                                                Command="{Binding ShowListViewCommand}"
                                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewList]}">
                                            <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                                Path="/Assets/Icons/viewList.svg"
                                                Width="18"
                                                Height="18"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>                                       </Button>
                                        <Button Classes="ghost" Classes.selected="{Binding IsCompactView}"
                                                Command="{Binding ShowCompactViewCommand}"
                                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewCompact]}">
                                            <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                                Path="/Assets/Icons/viewGrid.svg"
                                                Width="18"
                                                Height="18"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>   
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- App update -->
                            <Border Classes="infoBar" Margin="0,0,0,12" IsVisible="{Binding IsUpdateBannerVisible}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/info.svg"
                                        Width="16"
                                        Height="16"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>   
                                    <TextBlock Grid.Column="1" Margin="12,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[UpdateAvailableTitle]}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"
                                               Text="{Binding AvailableUpdateText}"/>
                                    <Button Grid.Column="3" Classes="subtle" Margin="12,0,4,0"
                                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Update]}"
                                            Command="{Binding OpenUpdatePanelCommand}"/>
                                    <Button Grid.Column="4" Classes="ghost icon"
                                            Command="{Binding DismissUpdateBannerCommand}"
                                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dismiss]}">
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/close.svg"
                                        Width="24"
                                        Height="24"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>   
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Result of the last mod operation -->
                            <Border Grid.Row="2" Classes="infoBar" Margin="0,0,0,12"
                                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/info.svg"
                                        Width="16"
                                        Height="16"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"   
                                        IsVisible="{Binding IsStatusError}"/>
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/check.svg"
                                        Width="16"
                                        Height="16"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !IsStatusError}"/>
                                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding StatusMessage}"/>
                                    <Button Grid.Column="2" Classes="ghost icon"
                                            Command="{Binding DismissStatusCommand}"
                                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dismiss]}">
                                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Grid.Column="0"
                                        Path="/Assets/Icons/close.svg"
                                        Width="24"
                                        Height="24"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>   
                                    </Button>
                                </Grid>
                            </Border>

                            <Panel Grid.Row="3">
                                <views:OnlineModsView IsVisible="{Binding IsBrowsePage}"/>
                                <views:InstalledModsView IsVisible="{Binding IsLibraryPage}"/>
                                <views:UpdatesView IsVisible="{Binding IsUpdatesPage}"/>
                                <views:SettingsPanelView IsVisible="{Binding IsSettingsPage}"/>
                            </Panel>
                        </Grid>

                        <views:ModDetailsView Grid.Column="1" Width="321" 
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1,0,0,0"
                            IsVisible="{Binding !IsSettingsPage}"/>                    
                </Grid>
                </Border>
            </SplitView>

            <views:ConfirmRemoveModView IsVisible="{Binding IsConfirmRemoveOpen}"/>
            <views:ConfirmDeployModView IsVisible="{Binding IsConfirmDeployOpen}"/>
            <views:UpdatePanelView IsVisible="{Binding IsUpdatePanelOpen}"/>

        </Grid>

    </Grid>
</Window>

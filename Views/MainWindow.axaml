<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StellarModManager.ViewModels"
        xmlns:views="using:StellarModManager.Views"
        xmlns:loc="using:StellarModManager.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
        x:Class="StellarModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Logo.ico"
        Title="StellarModManager"
        Width="1000" Height="720"
        MinWidth="460" MinHeight="480"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*" ColumnDefinitions="Auto,*">

        <!-- ICON RAIL: full height, only on the library screen -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Width="60"
                IsVisible="{Binding !SetupRequired}"
                Background="{DynamicResource Theme.TitleBarBackgroundBrush}">

            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0"
                        Width="34" Height="34"
                        Margin="0,52,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- the mark is a flat light grey, so light mode needs the dark cut -->
                    <Grid>
                        <Image Source="/Assets/Logo.png" Stretch="Uniform"
                               IsVisible="{DynamicResource Theme.IsDark}"/>
                        <Image Source="/Assets/LogoDark.png" Stretch="Uniform"
                               IsVisible="{DynamicResource Theme.IsLight}"/>
                    </Grid>
                </Border>

                <Button Grid.Row="2"
                        Classes="railButton"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SettingsTooltip]}">
                    <Path Width="20" Height="20"
                          Stretch="Uniform"
                          Fill="{DynamicResource Theme.IconGlyphBrush}"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                </Button>

            </Grid>
        </Border>

        <!-- CUSTOM TITLEBAR -->
        <Grid Grid.Row="0" Grid.Column="1" Background="{DynamicResource Theme.TitleBarBackgroundBrush}">

            <Border Name="TitleBarDrag"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

            <!-- app name; not hit-test visible so dragging still works underneath it -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppName]}"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.IconGlyphBrush}"
                       Margin="0"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       IsHitTestVisible="False"/>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch">

                <Button Name="MinimizeButton" Classes="captionButton" Click="OnMinimizeClick">
                    <Path Width="14" Height="14"
                          Stroke="{DynamicResource Theme.IconGlyphBrush}" StrokeThickness="1.2"
                          Data="M0.5,7 H13.5"/>
                </Button>

                <Button Name="MaximizeButton" Classes="captionButton" Click="OnMaximizeClick">
                    <Panel>
                        <Path Name="MaximizeGlyph" Width="14" Height="14"
                              Stroke="{DynamicResource Theme.IconGlyphBrush}" StrokeThickness="1.2"
                              Data="M0.5,0.5 H13.5 V13.5 H0.5 Z"/>
                        <Path Name="RestoreGlyph" Width="14" Height="14"
                              Stroke="{DynamicResource Theme.IconGlyphBrush}" StrokeThickness="1.2"
                              IsVisible="False"
                              Data="M0.5,2.5 H2.5 M2.5,0.5 H13.5 V11.5 H11.5 M11.5,13.5 H0.5 V2.5"/>
                    </Panel>
                </Button>

                <Button Name="CloseButton" Classes="captionButton close" Click="OnCloseClick">
                    <Path Width="14" Height="14"
                          Stroke="{DynamicResource Theme.IconGlyphBrush}" StrokeThickness="1.2"
                          Data="M0.5,0.5 L13.5,13.5 M13.5,0.5 L0.5,13.5"/>
                </Button>

            </StackPanel>

        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- SETUP PANEL -->
            <views:SetupPanelView IsVisible="{Binding SetupRequired}"/>

            <!-- MAIN APP -->
            <views:MainLibraryView IsVisible="{Binding !SetupRequired}"/>

            <views:ModDetailsView IsVisible="{Binding IsModDetailsOpen}"/>
            <views:SettingsPanelView IsVisible="{Binding IsSettingsOpen}"/>
            <views:ConfirmRemoveModView IsVisible="{Binding IsConfirmRemoveOpen}"/>
            <views:UpdatePanelView IsVisible="{Binding IsUpdatePanelOpen}"/>

        </Grid>

    </Grid>

</Window>
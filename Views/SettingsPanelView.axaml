<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarModManager.ViewModels"
             xmlns:loc="using:StellarModManager.Services"
             x:Class="StellarModManager.Views.SettingsPanelView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Spacing="4" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,24">

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Classes="sectionTitle" FontWeight="Normal"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[GameFolderLabel]}"/>
                        <TextBlock Classes="secondary" Text="{Binding GamePath}" TextTrimming="PrefixCharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="subtle"
                            Command="{Binding SelectGameFolderCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ChangeGameFolder]}"/>
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="sectionTitle" FontWeight="Normal" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[LanguageLabel]}"/>
                    <ComboBox Grid.Column="1" MinWidth="200"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding Converter={x:Static vm:MainWindowViewModel.LanguageNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="sectionTitle" FontWeight="Normal" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ThemeLabel]}"/>
                    <ComboBox Grid.Column="1" MinWidth="200"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"/>
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ConfirmBeforeRemoveLabel]}"
                              IsChecked="{Binding ConfirmBeforeRemove}"/>
                    <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoCheckModUpdatesLabel]}"
                              IsChecked="{Binding AutoCheckForModUpdates}"/>
                    <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoCheckAppUpdatesLabel]}"
                              IsChecked="{Binding AutoCheckForAppUpdates}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

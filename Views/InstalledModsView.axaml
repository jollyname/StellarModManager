<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StellarModManager.Controls"
             xmlns:vm="using:StellarModManager.ViewModels"
             xmlns:models="using:StellarModManager.Models"
             xmlns:loc="using:StellarModManager.Services"
             x:Class="StellarModManager.Views.InstalledModsView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Column headers -->
        <Grid Grid.Row="0" IsVisible="{Binding !IsCompactView}" ColumnDefinitions="60,*,80,80" Height="32" Margin="12,0">
            <TextBlock Grid.Column="1" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnName]}"/>
            <TextBlock Grid.Column="2" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnVersion]}"/>
            <TextBlock Grid.Column="3" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnLatest]}"/>
        </Grid>
        <Rectangle Grid.Row="0" Classes="separator" VerticalAlignment="Bottom" IsVisible="{Binding !IsCompactView}"/>

        <TextBlock Grid.Row="1" Classes="secondary" FontSize="14" Margin="12,16"
                   IsVisible="{Binding !LibraryMods.Count}"
                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NoInstalledMods]}"/>

        <ListBox Grid.Row="1" Classes="table" IsVisible="{Binding !IsCompactView}"
                 Margin="0,4,0,0"
                 ItemsSource="{Binding LibraryMods}"
                 SelectedItem="{Binding LibrarySelection}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledModInfo">
                    <Grid>
                        <Border Classes="pill"/>
                        <Grid ColumnDefinitions="60,*,80,80" Margin="12,0">
                            <Border Classes="thumbnail" Width="48" Height="48" HorizontalAlignment="Left">
                                <Image Source="{Binding Online.ThumbnailImage, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="14" MaxWidth="200"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <Border Classes="tag" IsVisible="{Binding IsExternal}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ExternalMod]}"/>
                                    </Border>
                                    <Border Classes="depWarn" IsVisible="{Binding HasDependencyWarning}"
                                            ToolTip.Tip="{Binding DependencyWarning}">
                                        <TextBlock Text="!"/>
                                    </Border>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="secondary" Text="{Binding Author}" MaxWidth="160" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Online.ModTags}"
                                                  Height="20" ClipToBounds="True" VerticalAlignment="Center"
                                                  IsVisible="{Binding Online.ModTags.Count}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemHeight="20"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModTag">
                                                <Border Classes="tag" Margin="0,0,4,0" VerticalAlignment="Center"
                                                        Classes.assisted="{Binding IsAssisted}"
                                                        Classes.vibecoded="{Binding IsVibecoded}"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.inactive="{Binding IsInactive}">
                                                    <TextBlock Text="{Binding Text}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Classes="cell" Text="{Binding DisplayVersion}"/>
                            <TextBlock Grid.Column="3" Classes="cell accent" Text="{Binding LatestVersion}"
                                       IsVisible="{Binding IsUpdateAvailable}"/>
                            <TextBlock Grid.Column="3" Classes="cell" Text="{Binding DisplayVersion}"
                                       IsVisible="{Binding IsCurrent}"/>

                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Compact view: card grid -->
        <ListBox Grid.Row="1" Classes="cards" Margin="0,4,0,0"
                 IsVisible="{Binding IsCompactView}"
                 ItemsSource="{Binding LibraryMods}"
                 SelectedItem="{Binding LibrarySelection}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:GridWrapPanel ItemWidth="225" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledModInfo">
                    <Grid RowDefinitions="Auto,Auto">
                        
                        <c:AspectRatio WidthParameter="16" HeightParameter="9">
                            <Border Classes="cardThumbnail">
                                <Image Source="{Binding Online.ThumbnailImage, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                            </Border>
                        </c:AspectRatio>

                        <StackPanel Grid.Row="1" Margin="12,10,12,12" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                <Border Grid.Column="1" Margin="6,0,0,0" Classes="tag"
                                        IsVisible="{Binding IsExternal}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ExternalMod]}"/>
                                </Border>
                                <Border Grid.Column="2" Margin="6,0,0,0" Classes="depWarn"
                                        IsVisible="{Binding HasDependencyWarning}"
                                        ToolTip.Tip="{Binding DependencyWarning}">
                                    <TextBlock Text="!"/>
                                </Border>
                            </Grid>
                            <TextBlock Classes="secondary" Text="{Binding Author}" TextTrimming="CharacterEllipsis"/>

                            <ItemsControl ItemsSource="{Binding Online.ModTags}" Margin="0,6,0,0"
                                          IsVisible="{Binding Online.ModTags.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModTag">
                                        <Border Classes="tag"
                                                Classes.assisted="{Binding IsAssisted}"
                                                Classes.vibecoded="{Binding IsVibecoded}"
                                                Classes.active="{Binding IsActive}"
                                                Classes.inactive="{Binding IsInactive}"
                                                Margin="0,0,4,4">
                                            <TextBlock Text="{Binding Text}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="secondary" Text="{Binding DisplayVersion}"/>
                                <TextBlock Classes="secondary" Text="→" IsVisible="{Binding IsUpdateAvailable}"/>
                                <TextBlock Classes="secondary accent" Text="{Binding LatestVersion}" IsVisible="{Binding IsUpdateAvailable}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>

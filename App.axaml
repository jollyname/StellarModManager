<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StellarModManager.App"
             xmlns:local="using:StellarModManager"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://StellarModManager/Styles/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <!-- Dropdowns -->
        <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="Theme.ContentBrush"/>
        <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="Theme.BorderBrush"/>
        <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="Theme.SurfaceBrush"/>
        <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="Theme.TextPrimaryBrush"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="Theme.SurfaceHoverBrush"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="Theme.TextPrimaryBrush"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="Theme.SurfaceHoverBrush"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="Theme.TextPrimaryBrush"/>
        <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="Theme.SurfaceHoverBrush"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="Theme.SurfaceHoverBrush"/>

        <!-- Defaults, replaced at startup by ThemeService from Data/Themes -->
        <SolidColorBrush x:Key="Theme.BackgroundBrush" Color="#202020"/>
        <SolidColorBrush x:Key="Theme.ContentBrush" Color="#282828"/>
        <SolidColorBrush x:Key="Theme.PanelBrush" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="Theme.SurfaceBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="Theme.SurfaceHoverBrush" Color="#383838"/>
        <SolidColorBrush x:Key="Theme.BorderBrush" Color="#3A3A3A"/>

        <SolidColorBrush x:Key="Theme.AccentBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="Theme.AccentHoverBrush" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="Theme.AccentPressedBrush" Color="#3AA7DD"/>
        <SolidColorBrush x:Key="Theme.AccentForegroundBrush" Color="#000000"/>

        <SolidColorBrush x:Key="Theme.TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.TextSecondaryBrush" Color="#C5C5C5"/>
        <SolidColorBrush x:Key="Theme.TextMutedBrush" Color="#8A8A8A"/>

        <SolidColorBrush x:Key="Theme.SuccessBrush" Color="#6CCB5F"/>

        <SolidColorBrush x:Key="Theme.DangerBrush" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Theme.DangerHoverBrush" Color="#B0261A"/>
        <SolidColorBrush x:Key="Theme.DangerPressedBrush" Color="#9A2016"/>

        <x:String x:Key="Theme.IconCss">.icon-fill { fill: #FFFFFF; } .icon-stroke { stroke: #FFFFFF; }</x:String>
    </Application.Resources>
</Application>
